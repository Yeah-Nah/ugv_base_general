ARDUINO_CLI_VERSION=0.35.3
ESP32_CORE_VERSION=2.0.14
# Arduino IDE: ESP32 Dev Module with the confirmed compile-relevant Tools options.
ESP32_FQBN=esp32:esp32:esp32:CPUFreq=240,DebugLevel=none,EventsCore=1,LoopCore=1,FlashFreq=80,FlashMode=qio,FlashSize=4M,PartitionScheme=default,PSRAM=disabled
# IDE upload setting; this does not change the compiled firmware bytes.
ESP32_UPLOAD_SPEED=921600

# Library versions installed in Arduino IDE when the last hardware-validated
# build (SCServo wFlushSCS fix, 2026-05-04) was compiled; read from each
# library's library.properties in Documents/Arduino/libraries.
ARDUINOJSON_VERSION=7.4.3
ADAFRUIT_SSD1306_VERSION=2.5.16
ADAFRUIT_GFX_VERSION=1.12.6
INA219_WE_VERSION=1.3.8
ESP32_ENCODER_VERSION=0.12.0
PID_V2_VERSION=2.0.1
SIMPLE_KALMAN_FILTER_VERSION=0.2.0
ADAFRUIT_ICM20X_VERSION=2.0.7
ADAFRUIT_BUSIO_VERSION=1.17.4
ADAFRUIT_SENSOR_VERSION=1.1.15